# sample はサンプル、manual は手選び動画、x はPostgreSQLのランキングを表示する。
RANKING_SOURCE=sample
DATABASE_URL=postgresql://videotrend:videotrend@127.0.0.1:54320/videotrend
# 本番のマイグレーション接続先。省略すると DATABASE_URL を使う。
DATABASE_MIGRATION_URL=
X_BEARER_TOKEN=
CRON_SECRET=
X_SEARCH_LIMIT=20
X_SEARCH_PAGES=1
X_TRACKED_PER_WINDOW=10
# 公開時に設定する投稿の掲載・取り下げに関する連絡先。
CONTACT_EMAIL=
# 任意。Sentryのプロジェクトで発行したDSNを設定する。
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
